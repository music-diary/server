{
  "AWSEBDockerrunVersion": 2,
  "volumes": [
    {
      "name": "node-app",
      "host": {
        "sourcePath": "/var/app/current/node-app"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "node-app",
      "image": "node:20-alpine",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 5000
        }
      ],
      "command": [
        "/bin/bash",
        "/usr/src/app/run.sh"
      ],
      "mountPoints": [
        {
          "sourceVolume": "node-app",
          "containerPath": "/usr/src/app"
        }
      ]
    }
  ]
}
